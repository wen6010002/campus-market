# ===== App =====
NODE_ENV=development
APP_BASE_URL=https://kedahub.cn             #required 支付回调用；本地开发改回 http://localhost:3000

# ===== Database =====
# 注意：宿主端口用 5433 而非 5432，避免与本机 Homebrew PostgreSQL 冲突（见 docker/docker-compose.yml）
DATABASE_URL=postgresql://cm:cm@localhost:5433/campus_market        #required
DATABASE_URL_POOLED=postgresql://cm:cm@localhost:6433/campus_market #运行时走 PgBouncer(可选，未配置回退直连)
DATABASE_URL_TEST=postgresql://cm:cm@localhost:5433/campus_market_test

# ===== Redis =====
REDIS_URL=redis://localhost:6379            #required

# ===== Auth =====
AUTH_SECRET=change-me-please-32-bytes-min   #required 生成：openssl rand -base64 32
AUTH_TRUST_HOST=true
JWT_COOKIE_NAME=cm_token
PASSWORD_PEPPER=change-me-pepper            #追加 pepper

# ===== Mail (edu 验证码) =====
SMTP_HOST=localhost
SMTP_PORT=1025                              # mailhog/smtp4dev 默认
SMTP_USER=
SMTP_PASS=
MAIL_FROM="课搭 <no-reply@kedahub.cn>"
VERIFY_CODE_TTL_MIN=10
VERIFY_CODE_LEN=6
EDU_EMAIL_REGEX=^[^@]+@(([a-zA-Z0-9-]+\.)*szu\.edu\.cn|szdx\.wecom\.work)$

# ===== Storage (MinIO) =====
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=campus-market
S3_PUBLIC_BASE=http://localhost:9000         #签名下载用（历史变量，已被 S3_PUBLIC_ENDPOINT 取代）
# V7：对外签名端点（浏览器 presigned URL 用；生产=https://kedahub.cn，Caddy /campus-market/* 反代 minio）
S3_PUBLIC_ENDPOINT=

# ===== Payment =====
# V6 起仅支付宝（码支付/易支付协议）；V7 增加 off = 支付封存·全站免费（接口拒绝/完整预览/免费下载，价格数据保留）
PAYMENT_MODE=mock                            #mock | epay | off
EPAY_GATEWAY=https://pay.fengxiaonb.icu
EPAY_PID=
EPAY_KEY=
EPAY_NOTIFY_URL=${APP_BASE_URL}/api/v1/webhooks/pay/epay
EPAY_RETURN_URL=${APP_BASE_URL}/pay/result
# 前端构建期注入（docker build --build-arg NEXT_PUBLIC_PAYMENT_MODE=off；本地 dev 需 export 同名变量）
NEXT_PUBLIC_PAYMENT_MODE=
ORDER_TIMEOUT_MIN=15                         #未支付订单关闭

# ===== Income =====
PLATFORM_FEE_RATE=0.1                        #平台抽成 10%
INCOME_SETTLE_DAYS=7                         #T+N 结算

# ===== Rate limit =====
RL_LOGIN_PER_MIN=10
RL_VERIFY_PER_HOUR=5
RL_RESET_PER_HOUR=5
RL_RESET_TRY_PER_HOUR=10
RL_PWD_PER_MIN=10
RL_PAY_PER_MIN=10

# ===== Sentry (optional) =====
SENTRY_DSN=
# V3-7 新生专区横幅开关（开学季运营位）：off 时首页横幅整体下线
NEXT_PUBLIC_FRESHMAN_ZONE=on
