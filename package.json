{
  "name": "campus-market",
  "version": "0.2.0",
  "private": true,
  "description": "Campus Market — 大学生成长社区 + 校园知识内容市场（Next.js 全栈单项目）",
  "scripts": {
    "prepare:pdf-worker": "node scripts/prepare-pdf-worker.mjs",
    "dev": "pnpm prepare:pdf-worker && next dev",
    "build": "pnpm prepare:pdf-worker && next build",
    "start": "next start",
    "worker": "tsx src/server/jobs/scheduler.ts",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:test": "tsx prisma/seed.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:integration": "vitest run --dir tests/integration",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@sentry/cli",
      "esbuild",
      "sharp",
      "@swc/core",
      "unrs-resolver",
      "msgpackr-extract",
      "msw"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "@hookform/resolvers": "^3.9.0",
    "@prisma/client": "~5.18.0",
    "@sentry/nextjs": "^8.26.0",
    "@tanstack/react-query": "^5.51.11",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.12",
    "dayjs": "^1.11.11",
    "dompurify": "^3.1.6",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "minio": "^8.0.1",
    "next": "~14.2.5",
    "nodemailer": "^6.9.14",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.1",
    "sanitize-html": "^2.13.0",
    "zod": "~3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@playwright/test": "^1.46.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.10",
    "@types/nodemailer": "^6.4.15",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.11.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "~14.2.5",
    "husky": "^9.0.11",
    "jsdom": "^24.1.0",
    "lint-staged": "^15.2.7",
    "msw": "^2.3.4",
    "prettier": "^3.3.3",
    "prisma": "~5.18.0",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "~5.4.5",
    "vitest": "^1.6.0"
  }
}
